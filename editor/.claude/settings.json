{
  "permissions": {
    "allow": [
      "Bash(cargo:*)",
      "Bash(tofu:*)",
      "Bash(nbd:*)",
      "Bash(git:*)"
    ],
    "ask": [
      "Bash(tofu apply:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "beans prime" }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "beans prime" }] }
    ]
  }
}
